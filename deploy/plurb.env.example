# /etc/plurb/plurb.env — chmod 600, owned by root
PLURB_ADDR=127.0.0.1:8080
PLURB_BASE_URL=https://plurb.org
DATABASE_URL=postgres://plurb:CHANGE_ME@localhost:5432/plurb?sslmode=disable

# nginx sets X-Real-IP; trust it for rate limits and view de-duplication.
PLURB_TRUST_PROXY=1

# Optional: Redis for caching, rate limits and buffered view counts.
# Without it everything runs in-process (fine for a single instance).
REDIS_URL=redis://localhost:6379/0

# "open" lets anyone sign up; anything else keeps sign-up closed.
PLURB_SIGNUP=closed

# GitHub OAuth app (callback: https://plurb.org/auth/github/callback).
# Leave empty to disable GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
